# =====================================================================
# Conversion Tracker — variáveis de ambiente
# Copie esse arquivo para .env e preencha os valores. NÃO faça commit do .env.
# O docker-compose carrega o .env via `env_file:`.
# =====================================================================

# === Aplicação =======================================================
APP_ENV=development          # development | production
LOG_LEVEL=info               # debug | info | warn | error

# === URLs públicas ===================================================
APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080/api/v1

# Host alvo para CNAMEs dos clientes (first-party tracking).
# Os clientes apontam o subdomínio deles via CNAME para esse host.
# Ex: cliente cria "tracking.cliente.com CNAME track.trackfind.com.br".
# Em dev fica vazio (DNS não funciona em localhost).
TRACKING_TARGET_HOST=

# === HTTP server =====================================================
HTTP_ADDR=:8080
STRICT_CORS=false

# === Auth admin ======================================================
# Gere um segredo grande: openssl rand -hex 64
JWT_SECRET=troque-isto-por-uma-string-grande-e-aleatoria
JWT_EXPIRES_HOURS=24
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-essa-senha

# === Postgres ========================================================
# Pode usar Postgres local (docker-compose) OU remoto (EasyPanel/RDS/etc.).
# Connection string completa:
#   postgres://USUARIO:SENHA@HOST:PORTA/NOMEDOBANCO?sslmode=require
DATABASE_URL=postgres://tracker:tracker@postgres:5432/tracker?sslmode=disable

# Variáveis usadas só pelo serviço postgres LOCAL do docker-compose.
# Se for apontar pra Postgres remoto, deixe em branco.
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=tracker

# === Redis (asynq) ===================================================
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_DB=0
REDIS_TLS=false
REDIS_TLS_INSECURE_SKIP_VERIFY=false

# === GeoIP MaxMind (opcional) ========================================
GEOIP_DB_PATH=/app/data/GeoLite2-City.mmdb
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# === Meta CAPI =======================================================
META_API_VERSION=v25.0
META_PARTNER_AGENT=

# === Webhooks de gateway =============================================
WEBHOOK_YAMPI_SECRET=
