# =====================================================================
# Conversion Tracker — variáveis de ambiente
# Copie esse arquivo para .env e preencha os valores. NÃO faça commit do .env.
# O docker-compose carrega o .env via `env_file:`.
# =====================================================================

# === Aplicação =======================================================
APP_ENV=development          # development | production
LOG_LEVEL=info               # debug | info | warn | error

# === URLs públicas ===================================================
APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080/api/v1

# Host alvo para CNAMEs dos clientes (first-party tracking).
# Os clientes apontam o subdomínio deles via CNAME para esse host.
# Ex: cliente cria "tracking.cliente.com CNAME track.trackfind.com.br".
# Em dev fica vazio (DNS não funciona em localhost).
TRACKING_TARGET_HOST=

# === Retenção =========================================================
# Quantos dias os eventos completos (sent_events) ficam no banco.
# Default 7. Use 0 pra desabilitar prune (cuidado com volume).
SENT_EVENTS_RETENTION_DAYS=7
# Quantos dias os agregados (event_counters) ficam. Default 90.
EVENT_COUNTERS_RETENTION_DAYS=90

# === HTTP server =====================================================
HTTP_ADDR=:8080
STRICT_CORS=false

# === Auth admin ======================================================
# Gere um segredo grande: openssl rand -hex 64
JWT_SECRET=troque-isto-por-uma-string-grande-e-aleatoria
JWT_EXPIRES_HOURS=24
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-essa-senha

# === Postgres ========================================================
# Pode usar Postgres local (docker-compose) OU remoto (EasyPanel/RDS/etc.).
# Connection string completa:
#   postgres://USUARIO:SENHA@HOST:PORTA/NOMEDOBANCO?sslmode=require
DATABASE_URL=postgres://tracker:tracker@postgres:5432/tracker?sslmode=disable

# Variáveis usadas só pelo serviço postgres LOCAL do docker-compose.
# Se for apontar pra Postgres remoto, deixe em branco.
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=tracker

# === Redis (asynq / cache / pubsub) ==================================
# Suporta tanto REDIS_URL (padrão EasyPanel: redis://default:senha@host:6379/0)
# quanto os campos individuais abaixo:
REDIS_URL=
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_DB=0
REDIS_TLS=false
REDIS_TLS_INSECURE_SKIP_VERIFY=false

# === MinIO / Object Storage S3 (Mídias WhatsApp — retenção 14 dias) ===
# Aceita host:port interno (ex: trackeado-minio:9000 ou projeto_minio:9000 no EasyPanel)
# ou URL completa (https://s3.seudominio.com).
MINIO_ENDPOINT=trackeado-minio:9000
MINIO_ACCESS_KEY=trackeado_minio_admin
MINIO_SECRET_KEY=troque-por-senha-minio-forte
MINIO_BUCKET=trackeado-whatsapp
MINIO_USE_SSL=false
MINIO_REGION=
WHATSAPP_MEDIA_RETENTION_DAYS=14

# === GeoIP MaxMind (opcional) ========================================
GEOIP_DB_PATH=/app/data/GeoLite2-City.mmdb
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# === Meta CAPI =======================================================
META_API_VERSION=v25.0
META_PARTNER_AGENT=

# === TikTok Events API ===============================================
# Vazio = não envia "partner_name" (TikTok rejeita partners não aprovados).
# Só preencha se a TikTok aprovou TrackFind como partner integrador.
TIKTOK_PARTNER_NAME=

# === Google Ads Conversions API ======================================
# Developer Token (Google Ads → Tools → API Center).
GOOGLE_ADS_DEVELOPER_TOKEN=

# OAuth do Google (Google Cloud Console). Mesma credencial pra todos os
# clientes — cada um autoriza sua conta via fluxo OAuth no painel.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/admin/google-ads/oauth/callback

# === Webhooks de gateway =============================================
WEBHOOK_YAMPI_SECRET=
