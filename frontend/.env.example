# TrackFind Frontend - Variáveis de Ambiente
# Copie para frontend/.env e ajuste para o seu ambiente.

# URL da API Backend (Go)
# Em dev: http://localhost:8080/api/v1
# Em prod: https://api.seu-dominio.com/api/v1
NUXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# URL pública do frontend
# Em dev: http://localhost:3000
# Em prod: https://painel.seu-dominio.com
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Nome da aplicação
NUXT_PUBLIC_APP_NAME=TrackFind

# Ambiente (development, production)
NODE_ENV=development
