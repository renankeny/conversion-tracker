FROM --platform=$BUILDPLATFORM golang:1.22-alpine AS builder
ARG TARGETOS=linux
ARG TARGETARCH=amd64
RUN apk add --no-cache git ca-certificates
WORKDIR /build
RUN git clone --depth 1 --branch RELEASE.2024-01-13T07-53-03Z https://github.com/minio/minio.git .
RUN if [ "$TARGETARCH" = "amd64" ]; then export GOAMD64=v1; fi && \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags "\
    -s -w \
    -X github.com/minio/minio/cmd.Version=2024-01-13T07:53:03Z \
    -X github.com/minio/minio/cmd.ReleaseTag=RELEASE.2024-01-13T07-53-03Z-cpuv1 \
    -X github.com/minio/minio/cmd.CommitID=993d96feef0e6b93d963932a66e2a50d3157575e \
    -X github.com/minio/minio/cmd.ShortCommitID=993d96feef0e" \
    -o /out/minio .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata && \
    mkdir -p /data && \
    printf '#!/bin/sh\nset -e\nif [ "$#" -eq 0 ]; then\n  set -- minio server /data --console-address ":9001"\nelif [ "$1" != "minio" ]; then\n  set -- minio "$@"\nfi\nexec "$@"\n' > /usr/bin/docker-entrypoint.sh && \
    chmod +x /usr/bin/docker-entrypoint.sh
COPY --from=builder /out/minio /usr/bin/minio
EXPOSE 9000 9001
VOLUME ["/data"]
ENTRYPOINT ["/usr/bin/docker-entrypoint.sh"]
CMD ["minio", "server", "/data", "--console-address", ":9001"]
