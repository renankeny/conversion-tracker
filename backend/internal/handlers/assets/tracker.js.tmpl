  if (bootMeta.fbp) clientUserData.fbp = bootMeta.fbp;

  bootstrapFbq();
  bootstrapTtq();
  bootstrapGa4();

  if (TF_CONFIG.auto_checkout_buttons) {
    setUTMs();
    setButtonsURLs();
  }
  setupWhatsAppLinks({
    protocol:  !!TF_CONFIG.whatsapp_protocol,
    lead:      !!TF_CONFIG.whatsapp_lead,
    leadEvent: TF_CONFIG.whatsapp_lead_event || "Lead"
  });
  if (TF_CONFIG.auto_form_lead) setupFormLeadTracking();
  if (TF_CONFIG.send_scrolls) setupScrollTracking();
  if (TF_CONFIG.send_timer_1min) setupTimerTracking();
  if (TF_CONFIG.send_view_video) setupVideoTracking();
  setupSpaListeners();

  // Dispara PageView + PageRules imediatamente (sem travar esperando RTT de Init)
  if (TF_CONFIG.auto_page_view) {
    sendEvent("PageView").then(applyPageRules);
  } else {
    applyPageRules();
  }

  // Hidrata GeoIP e atualiza Advanced Matching em paralelo
  sendEvent("Init").then(function (initData) {
    if (initData) lastInitData = initData;
    refreshFbqAdvancedMatching(lastInitData);
    refreshTtqIdentify(lastInitData);
  }).catch(function () {});

  // === API global ======================================================

  var pending = (window.tf && window.tf.q) || [];
  window.tf = function () {
    var args = Array.prototype.slice.call(arguments);
    var cmd = args.shift();
    if (cmd === "send" || cmd === "event") {
      sendEvent(args[0], args[1] || {});
    } else if (cmd === "updateUser") {
      var patch = args[0] || {};
      var current = getUserDataCookie();
      ["first_name", "last_name", "email", "phone"].forEach(function (k) {
        if (patch[k]) current[k] = patch[k];
      });
      saveUserDataCookie(current);
      refreshFbqAdvancedMatching(lastInitData);
      refreshTtqIdentify(lastInitData);
      sendEvent("UpdateUserData", patch);
