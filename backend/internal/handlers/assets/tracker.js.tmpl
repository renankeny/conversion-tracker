  function refreshTtqIdentify(initData) {
    if (!TF_TIKTOK_PIXEL_IDS || !TF_TIKTOK_PIXEL_IDS.length || !window.ttq) return;
    var fresh = getUserDataCookie();
    var identity = {};
    if (fresh.email) identity.email = String(fresh.email).trim().toLowerCase();
    var e164Phone = formatPhoneE164(fresh.phone);
    if (e164Phone) identity.phone_number = e164Phone;
    if (userId) identity.external_id = String(userId).trim().toLowerCase();
    try {
      window.ttq.identify(identity);
      if (typeof window.ttq.instance === "function") {
        for (var i = 0; i < TF_TIKTOK_PIXEL_IDS.length; i++) {
