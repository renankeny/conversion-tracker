  // === SPA Navigation Support ==========================================

  var lastTrackedPath = window.location.pathname + window.location.search;

  function onSpaRouteChange() {
    var curPath = window.location.pathname + window.location.search;
    if (curPath === lastTrackedPath) return;
    lastTrackedPath = curPath;

    sentOnce.InitiateCheckout = false;
    sentOnce.Scroll_25 = false;
    sentOnce.Scroll_50 = false;
    sentOnce.Scroll_75 = false;
    sentOnce.Scroll_90 = false;

    if (TF_CONFIG.auto_checkout_buttons) setUTMs();
    if (TF_CONFIG.auto_page_view) {
      sendEvent("PageView").then(applyPageRules);
    } else {
      applyPageRules();
    }
  }

  function setupSpaListeners() {
    try {
      if (window.history && window.history.pushState) {
        var origPush = window.history.pushState;
