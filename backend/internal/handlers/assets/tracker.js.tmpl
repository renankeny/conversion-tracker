    var iv = setInterval(function () {
      elapsed += 200;
      for (var p = 0; p < TF_TIKTOK_PIXEL_IDS.length; p++) {
        patchTikTokPixelRules(TF_TIKTOK_PIXEL_IDS[p]);
      }
      var allWrapped = true;
      if (window.ttq && !Array.isArray(window.ttq) && typeof window.ttq.instance === "function") {
        wrapTikTokTrackHolder(window.ttq);
        for (var k = 0; k < TF_TIKTOK_PIXEL_IDS.length; k++) {
          var inst = window.ttq.instance(TF_TIKTOK_PIXEL_IDS[k]);
          if (!inst || Array.isArray(inst) || !wrapTikTokTrackHolder(inst)) {
