  function watchTtpCookie(alreadyHadTtp) {
    if (alreadyHadTtp || !TF_TIKTOK_PIXEL_IDS || !TF_TIKTOK_PIXEL_IDS.length) return;
    var elapsed = 0;
    var iv = setInterval(function () {
      elapsed += 300;
      var ttp = getCookie("_ttp");
      if (ttp) {
        clearInterval(iv);
        setStorage("_ttp", ttp);
        sendEvent("UpdateUserData", { ttp: ttp });
